y\", marker=\"o\")\n    plt.title(\"Ablation: accuracy vs. context size, at max shift severity\")\n    plt.tight_layout()\n    plt.savefig(f\"{FIG_DIR}/fig4_ablation_context_size.png\", dpi=200, bbox_inches=\"tight\")\n    plt.show()\n    ctx_ablation.to_csv(\"table4_ablation_context_size.csv\", index=False)\nelse:\n    print(\"Context-size ablation needs QUICK_TEST=False (multiple CONTEXT_SIZES) to be meaningful — skipping for now.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-12T21:11:33.28878Z","iopub.status.idle":"2026-08-12T21:11:33.289073Z","shell.execute_reply.started":"2026-08-12T21:11:33.288954Z","shell.execute_reply":"2026-08-12T21:11:33.288969Z"}},"outputs":[],"execution_count":null},{"id":"79c8e097-d2f4-49de-930a-66f4adb03eb1","cell_type":"code","source":"# --- 9b: unlabeled target-data fraction ablation ---\nABLATION_DATASET = DATASETS_RUN[0]\nABLATION_SHIFT_TYPE = \"covariate\"\nABLATION_SEVERITY = 1.0\nFRACTIONS_TO_TEST = [0.05, 0.1, 0.2, 0.3, 0.5]\n\nfrac_results = []\ntry:\n    X_raw, y = load_dataset(ABLATION_DATASET)\n    shift_vals = X_raw[ABLATION_DATASET.shift_feature].astype(float).values\n    X_proc, _ = preprocess(X_raw)\n    X_train, y_train, X_test, y_test = split_covariate_shift(X_proc, y, shift_vals, ABLATION_SEVERITY, seed=SEED)\n\n    for frac in FRACTIONS_TO_TEST:\n        rng = np.random.RandomState(SEED)\n        n_test = len(X_test)\n        n_unlabeled = max(10, int(n_test * frac))\n        perm = rng.permutation(n_test)\n        X_target_unlabeled = X_test[perm[:n_unlabeled]]\n        X_score, y_score = X_test[perm[n_unlabeled:]], y_test[perm[n_unlabeled:]]\n        if len(np.unique(y_score)) < 2:\n            continue\n\n        for strategy_name in [\"random\", \"knn_to_target\", \"shift_aware_reweight\"]:\n            try:\n                idx = CONTEXT_STRATEGIES[strategy_name](X_train, y_train, X_target_unlabeled, 300, seed=SEED)\n                proba = run_tabpfn(X_train[idx], y_train[idx], X_score)\n                metrics = score_predictions(y_score, proba)\n                frac_results.append({\"unlabeled_fraction\": frac, \"strategy\": strategy_name, **metrics})\n            except Exception as e:\n                print(f\"  [skip] frac={frac} strategy={strategy_name}: {e}\")\n\n    frac_df = pd.DataFrame(frac_results)\n    frac_df.to_csv(\"table5_ablation_unlabeled_fraction.csv\", index=False)\n    if len(frac_df):\n        plt.figure(figsize=(7, 5))\n        sns.lineplot(data=frac_df, x=\"unlabeled_fraction\", y=\"accuracy\", hue=\"strategy\", marker=\"o\")\n        plt.title(f\"Ablation: how much unlabeled target data is needed? ({ABLATION_DATASET.name}, covariate shift, severity=1.0)\")\n        plt.tight_layout()\n        plt.savefig(f\"{FIG_DIR}/fig5_ablation_unlabeled_fraction.png\", dpi=200, bbox_inches=\"tight\")\n        plt.show()\nexcept Exception as e:\n    print(f\"[SKIP unlabeled-fraction ablation] {e}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-12T21:11:33.290264Z","iopub.status.idle":"2026-08-12T21:11:33.290508Z","shell.execute_reply.started":"2026-08-12T21:11:33.290392Z","shell.execute_reply":"2026-08-12T21:11:33.290405Z"}},"outputs":[],"execution_count":null},{"id":"830316e1-adca-4b1a-a482-17fc2a9edf93","cell_type":"code","source":"# --- 9c: domain-classifier choice ablation (logreg vs random_forest) for shift_aware_reweight ---\nclf_results = []\ntry:\n    X_raw, y = load_dataset(ABLATION_DATASET)\n    shift_vals = X_raw[ABLATION_DATASET.shift_feature].astype(float).values\n    X_proc, _ = preprocess(X_raw)\n    X_train, y_train, X_test, y_test = split_covariate_shift(X_proc, y, shift_vals, ABLATION_SEVERITY, seed=SEED)\n\n    rng = np.random.RandomState(SEED)\n    n_unlabeled = max(10, int(len(X_test) * 0.3))\n    perm = rng.permutation(len(X_test))\n    X_target_unlabeled = X_test[perm[:n_unlabeled]]\n    X_score, y_score = X_test[perm[n_unlabeled:]], y_test[perm[n_unlabeled:]]\n\n    for clf_type in [\"logreg\", \"random_forest\"]:\n        try:\n            idx = shift_aware_context(X_train, y_train, X_target_unlabeled, 300, seed=SEED, domain_clf_type=clf_type)\n            proba = run_tabpfn(X_train[idx], y_train[idx], X_score)\n            metrics = score_predictions(y_score, proba)\n            clf_results.append({\"domain_classifier\": clf_type, **metrics})\n        except Exception as e:\n            print(f\"  [skip] domain_classifier={clf_type}: {e}\")\n\n    clf_df = pd.DataFrame(clf_results)\n    print(\"Table 6 — domain-classifier choice ablation for shift_aware_reweight:\")\n    display(clf_df)\n    clf_df.to_csv(\"table6_ablation_domain_classifier.csv\", index=False)\nexcept Exception as e:\n    print(f\"[SKIP domain-classifier ablation] {e}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-12T21:11:33.291444Z","iopub.status.idle":"2026-08-12T21:11:33.291721Z","shell.execute_reply.started":"2026-08-12T21:11:33.291596Z","shell.execute_reply":"2026-08-12T21:11:33.291619Z"}},"outputs":[],"execution_count":null},{"id":"40156320-76ce-47b7-8630-59db57652425","cell_type":"markdown","source":"## 10. Explanation stability under shift (XAI)\n\nBeyond accuracy/calibration: does context curation also make the model's **reasoning** more stable under\nshift, not just its predictions? Using permutation importance (model-agnostic, works for TabPFN unlike\nSHAP's tree-specific fast path) on one representative dataset/shift-type, we compare feature-importance\nrankings at severity=0 (in-distribution) vs. max severity (out-of-distribution) for each context\nstrategy, via Spearman rank correlation. A strategy whose top features stay stable under shift is telling\na more trustworthy story than one whose predictions are merely still accurate.\n\n**Bounded to one dataset by default** (permutation importance means N_repeats extra model evaluations per\nfeature — expensive to multiply across the whole grid). Widen `XAI_DATASETS` if time allows after the\nmain results and paper draft are done.\n","metadata":{}},{"id":"7bac41f0-8b68-4484-9a2d-b6721bd84ffe","cell_type":"code","source":"XAI_DATASET = DATASETS_RUN[0]\nXAI_SHIFT_TYPE = \"covariate\"\nN_PERM_REPEATS = 5\n\nxai_results = []\ntry:\n    X_raw, y = load_dataset(XAI_DATASET)\n    shift_vals = X_raw[XAI_DATASET.shift_feature].astype(float).values\n    X_proc, feat_names = preprocess(X_raw)\n\n    importances_by_strategy = {}  # strategy -> {severity: importance_array}\n\n    for severity in [0.0, 1.0]:\n        X_train, y_train, X_test, y_test = split_covariate_shift(X_proc, y, shift_vals, severity, seed=SEED)\n        rng = np.random.RandomState(SEED)\n        n_unlabeled = max(10, int(len(X_test) * 0.3))\n        perm = rng.permutation(len(X_test))\n        X_target_unlabeled = X_test[perm[:n_unlabeled]]\n        X_score, y_score = X_test[perm[n_unlabeled:]], y_test[perm[n_unlabeled:]]\n        if len(np.unique(y_score)) < 2:\n            continue\n\n        for strategy_name in [\"random\", \"shift_aware_reweight\"]:\n            try:\n                idx = CONTEXT_STRATEGIES[strategy_name](X_train, y_train, X_target_unlabeled, 300, seed=SEED)\n                X_ctx, y_ctx = X_train[idx], y_train[idx]\n\n                from tabpfn import TabPFNClassifier\n                clf = TabPFNClassifier(device=TABPFN_DEVICE)\n                clf.fit(X_ctx, y_ctx)\n\n                # cap scoring rows for permutation_importance tractability\n                cap = min(len(X_score), 500)\n                pi = permutation_importance(clf, X_score[:cap], y_score[:cap],\n                                             n_repeats=N_PERM_REPEATS, random_state=SEED, scoring=\"accuracy\")\n                importances_by_strategy.setdefault(strategy_name, {})[severity] = pi.importances_mean\n            except Exception as e:\n                print(f\"  [skip] strategy={strategy_name} severity={severity}: {e}\")\n\n    from scipy.stats import spearmanr\n    for strategy_name, sev_dict in importances_by_strategy.items():\n        if 0.0 in sev_dict and 1.0 in sev_dict:\n            rho, p = spearmanr(sev_dict[0.0], sev_dict[1.0])\n            xai_results.append({\"strategy\": strategy_name, \"spearman_rho_id_vs_ood\": rho, \"p_value\": p})\n\n    xai_df = pd.DataFrame(xai_results)\n    print(f\"Table 7 — explanation stability ({XAI_DATASET.name}, covariate shift, severity 0.0 vs 1.0):\")\n    print(\"Higher Spearman rho = feature-importance ranking stays more stable under shift.\")\n    display(xai_df)\n    xai_df.to_csv(\"table7_explanation_stability.csv\", index=False)\n\n    if importances_by_strategy:\n        fig, axes = plt.subplots(1, len(importances_by_strategy), figsize=(6 * len(importances_by_strategy), 4), sharey=True)\n        if len(importances_by_strategy) == 1:\n            axes = [axes]\n        for ax, (strategy_name, sev_dict) in zip(axes, importances_by_strategy.items()):\n            width = 0.35\n            xpos = np.arange(len(feat_names))\n            if 0.0 in sev_dict:\n                ax.bar(xpos - width/2, sev_dict[0.0], width, label=\"severity=0.0 (ID)\")\n            if 1.0 in sev_dict:\n                ax.bar(xpos + width/2, sev_dict[1.0], width, label=\"severity=1.0 (OOD)\")\n            ax.set_xticks(xpos)\n            ax.set_xticklabels(feat_names, rotation=90, fontsize=7)\n            ax.set_title(strategy_name)\n            ax.legend(fontsize=8)\n        fig.suptitle(f\"Permutation importance, ID vs OOD ({XAI_DATASET.name})\", y=1.05)\n        plt.tight_layout()\n        plt.savefig(f\"{FIG_DIR}/fig6_explanation_stability.png\", dpi=200, bbox_inches=\"tight\")\n        plt.show()\nexcept Exception as e:\n    print(f\"[SKIP XAI section] {e}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-12T21:11:33.292866Z","iopub.status.idle":"2026-08-12T21:11:33.293227Z","shell.execute_reply.started":"2026-08-12T21:11:33.293053Z","shell.execute_reply":"2026-08-12T21:11:33.293076Z"}},"outpu