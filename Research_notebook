\")\n    print(\"    Check ok['status'].value_counts() / the failed-rows breakdown in Section 6a for why.\")\n\nMIN_PAIRED_CONFIGS = 5  # lower this (e.g. to 2) if you're deliberately running a tiny QUICK_TEST grid\n\nbaseline = \"random\"\nrows = []\nstrategies_to_test = [s for s in CONTEXT_STRATEGIES if s != baseline]\nfor strat in strategies_to_test:\n    if strat not in pivot.columns or baseline not in pivot.columns:\n        print(f\"  [skip] {strat}: column missing from pivot (no successful runs, or baseline itself is missing)\")\n        continue\n    paired = pivot[[baseline, strat]].dropna()\n    print(f\"  {strat}: {len(paired)} paired configs available\")\n    if len(paired) < MIN_PAIRED_CONFIGS:\n        print(f\"    [skip] below MIN_PAIRED_CONFIGS={MIN_PAIRED_CONFIGS} — need a bigger grid \"\n              f\"(more datasets/severities/seeds) for a trustworthy paired test\")\n        continue\n    stat, p = wilcoxon(paired[strat], paired[baseline])\n    rows.append({\"strategy\": strat, \"n_paired_configs\": len(paired),\n                 \"mean_accuracy_diff_vs_random\": (paired[strat] - paired[baseline]).mean(),\n                 \"wilcoxon_stat\": stat, \"p_value\": p})\n\nif rows:\n    table2 = pd.DataFrame(rows).sort_values(\"mean_accuracy_diff_vs_random\", ascending=False)\n    table2[\"p_value_bonferroni\"] = (table2[\"p_value\"] * len(table2)).clip(upper=1.0)\n    print(\"\\nTable 2 — paired comparison vs. random-context baseline (Bonferroni-corrected):\")\n    display(table2)\n    table2.to_csv(\"table2_paired_significance.csv\", index=False)\nelse:\n    table2 = pd.DataFrame(columns=[\"strategy\", \"n_paired_configs\", \"mean_accuracy_diff_vs_random\",\n                                    \"wilcoxon_stat\", \"p_value\", \"p_value_bonferroni\"])\n    table2.to_csv(\"table2_paired_significance.csv\", index=False)\n    print(\"\\n[!] No strategy had enough paired configs for a significance test yet.\")\n    print(\"    This is EXPECTED if you're o